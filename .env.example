# --- Supabase (Vercel + worker) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé administrateur : serveur Vercel et worker uniquement, jamais côté navigateur
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=
# URL publique du worker Railway (ex. https://worker-production.up.railway.app)
WORKER_URL=

# --- Stripe (Vercel) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- TikTok (Vercel + worker) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# false tant que l'audit Content Posting API n'est pas validé (publications forcées en privé)
TIKTOK_AUDITED=false
# 32 octets en base64 : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- IA (worker) ---
LLM_PROVIDER=            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=local   # local (faster-whisper) | openai

# --- Emails ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- Divers ---
WORKER_CONCURRENCY=1
SENTRY_DSN=
